{
  "name": "palworld-dashboard",
  "version": "0.1.4",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,collector \"next dev\" \"ts-node src/worker/index.ts\"",
    "build": "next build",
    "start": "concurrently -n next,collector \"next start\" \"node .next/standalone/worker/index.js\"",
    "lint": "eslint",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "dependencies": {
    "daisyui": "^5.5.14",
    "js-yaml": "^4.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
